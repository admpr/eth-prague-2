# Required: a funded Base Sepolia private key used ONLY to broadcast the EIP-7702 type-4
# transaction and pay gas. Never controls the user's account.
FIREFLY_RELAYER_PRIVATE_KEY=0x

# Optional: override the Base Sepolia RPC endpoint. Defaults to the public Base endpoint if unset.
# Must be prefixed NEXT_PUBLIC_ so the browser bundle can read it.
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org

# Required: deployed Base Sepolia AgentPermissionValidator module address.
NEXT_PUBLIC_AGENT_PERMISSION_VALIDATOR_ADDRESS=0x
